{
  "name": "sitio-web-mabudev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "start": "node server/index.js",
    "preview": "vite preview",
    "lint": "oxlint",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "leads": "node server/leads.js",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.52.0",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "description": "Landing de MabuDev — Alejandro Duke, desarrollador full stack",
  "engines": {
    "node": ">=20.19"
  }
}
